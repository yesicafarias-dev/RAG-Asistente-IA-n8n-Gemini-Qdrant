        0
      ],
      "id": "142d13b3-14ee-4f18-94cc-8174a948d73d",
      "name": "preparar prompt"
    },
    {
      "parameters": {
        "jsCode": "const texto = $input.first().json.candidates[0].content.parts[0].text\n\nconst limpio = texto\n  .replace(\"```json\", \"\")\n  .replace(\"```\", \"\")\n  .trim();\n\nconst data = JSON.parse(limpio);\nreturn [\n  {\n    json: {\n      Nombre: $('datos recuperados').first().json.Nombre,\n      Consulta: $('datos recuperados').first().json.Consulta,\n      respuesta: data.respuesta,\n      estado: data.estado\n    }\n  }\n];\n"
      },
